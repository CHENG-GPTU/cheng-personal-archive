# Public portfolio pages work without these private-workspace services.
# Put actual values in .env.local or your hosting provider, never in Git.
DATABASE_URL=
DEEPSEEK_API_KEY=
AIPM_SESSION_SECRET=
AIPM_ACCESS_CODE_HASH=
AIPM_OWNER_NAME=
AIPM_OWNER_ID=primary-owner
# Use cloud storage on a hosted deployment; local files are not persistent there.
AIPM_STORAGE_MODE=cloud
DEEPSEEK_COACH_MODEL=deepseek-v4-flash
DEEPSEEK_EVALUATION_MODEL=deepseek-v4-pro
